<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <gazebo>

        <!-- ===== DIFFERENTIAL DRIVE (drive wheels) ===== -->
        <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
            <left_joint>LF_joint</left_joint>
            <right_joint>RF_Wheel_joint</right_joint>
            <wheel_separation>0.66</wheel_separation>
            <wheel_radius>0.095</wheel_radius>
            <max_linear_acceleration>0.33</max_linear_acceleration>
            <topic>cmd_vel</topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>
            <odom_topic>odom</odom_topic>
            <odom_publisher_frequency>30</odom_publisher_frequency>
            <tf_topic>/tf</tf_topic>
        </plugin>

        <!-- ===== ARM POSITION CONTROLLER ===== -->
        <plugin name="gz::sim::systems::JointPositionController"
                filename="gz-sim-joint-position-controller-system">
            <joint_name>Arm_joint</joint_name>
            <topic>arm_position</topic>
            <p_gain>10.0</p_gain>
            <i_gain>0.01</i_gain>
            <d_gain>0.5</d_gain>
            <i_max>1.0</i_max>
            <i_min>-1.0</i_min>
            <cmd_max>10.0</cmd_max>
            <cmd_min>-10.0</cmd_min>
        </plugin>

        <!-- ===== NOZZLE POSITION CONTROLLER ===== -->
        <plugin name="gz::sim::systems::JointPositionController"
                filename="gz-sim-joint-position-controller-system">
            <joint_name>Nozel_joint</joint_name>
            <topic>nozzle_position</topic>
            <p_gain>10.0</p_gain>
            <i_gain>0.01</i_gain>
            <d_gain>0.5</d_gain>
            <i_max>1.0</i_max>
            <i_min>-1.0</i_min>
            <cmd_max>10.0</cmd_max>
            <cmd_min>-10.0</cmd_min>
        </plugin>

        <!-- ===== JOINT STATE PUBLISHER (all joints) ===== -->
        <plugin filename="gz-sim-joint-state-publisher-system"
                name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <!-- Drive wheels -->
            <joint_name>LF_joint</joint_name>
            <joint_name>RF_Wheel_joint</joint_name>
            <!-- Arm -->
            <joint_name>Arm_joint</joint_name>
            <joint_name>Nozel_joint</joint_name>
            <!-- Caster swivel joints (passive, no controller) -->
            <joint_name>LC_joint</joint_name>
            <joint_name>RC_joint</joint_name>
            <!-- Caster wheel joints (passive, no controller) -->
            <joint_name>LC_wheel_joint</joint_name>
            <joint_name>RC_wheel_joint</joint_name>
        </plugin>

    </gazebo>

</robot>
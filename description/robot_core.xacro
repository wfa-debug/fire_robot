<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

   <xacro:include filename="inertial_macros.xacro"/>


    <!-- ===== MATERIALS ===== -->

    <material name="dark_red">
        <color rgba="0.250980392156863 0 0 1"/>
    </material>

    <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
    </material>

    <material name="silver">
        <color rgba="0.776470588235294 0.756862745098039 0.737254901960784 1"/>
    </material>

    <material name="red">
        <color rgba="1 0 0 1"/>
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1"/>
    </material>


    <!-- BASE LINK -->

    <link name="base_link">

    </link>

        <!-- BASE_FOOTPRINT -->

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="base_footprint">
    </link>
    <!-- chassis: the actual physical body -->

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chasses_link"/>
        <origin xyz="-0.45 0 0.1" rpy="0 0 0"/>   <!-- adjust if needed -->
    </joint>

   <link
    name="chasses_link">
    <inertial>
      <origin
        xyz="0.014655 0.044421 0.1607"
        rpy="0 0 0" />
      <mass
        value="33.539" />
      <inertia
        ixx="1.2155"
        ixy="0.012793"
        ixz="0.03844"
        iyy="1.7301"
        iyz="-0.0057582"
        izz="2.2118" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fire_robot/description/meshes/chasses_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.250980392156863 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.15 0 0.15" rpy="0 0 0"/>
      <geometry>
        <box size="0.9 0.5 0.3"/>
      </geometry>
    </collision>
  </link>



   <link
    name="LF_Wheel_Link">
    <inertial>
      <origin
        xyz="0 -0.017 0"
        rpy="0 0 0" />
      <mass
        value="0.6852" />
      <inertia
        ixx="0.0017472"
        ixy="-3.8027E-19"
        ixz="1.0983E-19"
        iyy="0.0033941"
        iyz="-4.3413E-19"
        izz="0.0017472" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fire_robot/description/meshes/LF_Wheel_Link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
       <cylinder radius="0.095" length="0.05"/>
      </geometry>
    </collision>
  </link>



  <joint
    name="LF_joint"
    type="continuous">
    <origin
      xyz="0.45142 0.3425 0.04"
      rpy="0 0 0" />
    <parent
      link="chasses_link" />
    <child
      link="LF_Wheel_Link" />
    <axis
      xyz="0 1 0" />
    
    <limit effort="10.0" velocity="10.0"/>


  </joint>


  <link
    name="RF_Wheel_Link">
    <inertial>
      <origin
        xyz="-5.5511E-17 0.017 5.5511E-17"
        rpy="0 0 0" />
      <mass
        value="0.6852" />
      <inertia
        ixx="0.0017472"
        ixy="-1.1225E-19"
        ixz="8.9463E-20"
        iyy="0.0033941"
        iyz="-3.5867E-19"
        izz="0.0017472" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fire_robot/description/meshes/RF_Wheel_Link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
       <cylinder radius="0.095" length="0.05"/>
      </geometry>
    </collision>
  </link>



  <joint
    name="RF_Wheel_joint"
    type="continuous">
    <origin
      xyz="0.45142 -0.3425 0.04"
      rpy="0 0 0" />
    <parent
      link="chasses_link" />
    <child
      link="RF_Wheel_Link" />
    <axis
      xyz="0 1 0" />
  <limit effort="10.0" 
         velocity="10.0"/>
  </joint>



  <link
    name="RC_Link">
    <inertial>
      <origin
        xyz="0.0011142 9.6089E-05 -0.0040799"
        rpy="0 0 0" />
      <mass
        value="0.070329" />
      <inertia
        ixx="3.2762E-05"
        ixy="9.6444E-08"
        ixz="-3.6413E-06"
        iyy="3.1652E-05"
        iyz="-3.1401E-07"
        izz="5.4956E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fire_robot/description/meshes/RC_Link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
  <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>


  <joint
    name="RC_joint"
    type="continuous">
    <origin
      xyz="-0.35902 -0.097 -0.0095"
      rpy="0 0 -0.085" />
    <parent
      link="chasses_link" />
    <child
      link="RC_Link" />
    <axis
    xyz="0 0 1" />
    <limit effort="0.05" velocity="10.0"/>
  </joint>



  <link
    name="LC_Link">
    <inertial>
      <origin
        xyz="0.0010264 -0.00044407 -0.0040799"
        rpy="0 0 0" />
      <mass
        value="0.070329" />
      <inertia
        ixx="3.2593E-05"
        ixy="-4.1058E-07"
        ixz="-3.3543E-06"
        iyy="3.1822E-05"
        iyz="1.4512E-06"
        izz="5.4956E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fire_robot/description/meshes/LC_Link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
   <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
  </link>




  <joint
    name="LC_joint"
    type="continuous">
    <origin
      xyz="-0.35902 0.097 -0.0095"
      rpy="0 0 0.425" />
    <parent
      link="chasses_link" />
    <child
      link="LC_Link" />
    <axis
      xyz="0 0 1" />
    <limit effort="0.05" velocity="10.0"/>
    </joint>



  <link
    name="Arm_Link">
    <inertial>
      <origin
        xyz="0.047173 -0.021885 -0.003"
        rpy="0 0 0" />
      <mass
        value="0.33173" />
      <inertia
        ixx="0.00020256"
        ixy="0.00014004"
        ixz="9.4861E-19"
        iyy="0.00043945"
        iyz="-2.645E-19"
        izz="0.0006045" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fire_robot/description/meshes/Arm_Link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 -0.02 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.05 0.03"/>
      </geometry>
    </collision>
  </link>


  <joint
    name="Arm_joint"
    type="revolute">
    <origin
      xyz="0.092398 -0.02 0.476"
      rpy="0 0 0" />
    <parent
      link="chasses_link" />
    <child
      link="Arm_Link" />
    <axis
      xyz="0 0 -1" />
    <limit
      lower="-1.57"
      upper="1.57"
      effort="5.0"
      velocity="10" />
  </joint>



  <link
    name="Nozel_Link">
    <inertial>
      <origin
        xyz="0.0083525 -0.033639 -0.01418"
        rpy="0 0 0" />
      <mass
        value="0.10805" />
      <inertia
        ixx="2.889E-05"
        ixy="4.7007E-06"
        ixz="1.5916E-05"
        iyy="3.6841E-05"
        iyz="-7.3841E-06"
        izz="4.2155E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://fire_robot/description/meshes/Nozel_Link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.2 0.2 0.2 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.03 -0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.08 0.05"/>
      </geometry>
    </collision>
  </link>


  <joint
    name="Nozel_joint"
    type="revolute">
    <origin
      xyz="0.093005 -0.013384 -0.003"
      rpy="0 0 0" />
    <parent
      link="Arm_Link" />
    <child
      link="Nozel_Link" />
    <axis
      xyz="-0.42085 -0.90713 0" />
    <limit
      lower="-1.57"
      upper="1.57"
      effort="5.0"
      velocity="10" />
  </joint>



      <joint name="LC_wheel_joint" type="continuous">
        <parent link="LC_Link"/>
        <child link="LC_wheel"/>
        <origin xyz="-0.01 0.004 -0.031" rpy="-${pi/2} 0 -0.425" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="LC_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
                




<joint name="RC_wheel_joint" type="continuous">
        <parent link="RC_Link"/>
        <child link="RC_wheel"/>
        <origin xyz="-0.01 0 -0.031" rpy="-${pi/2} 0 0.085" />
        <axis xyz="0 0 1"/>
    </joint>

    <link name="RC_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.03" length="0.03"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
      

    <gazebo reference="RC_wheel">
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>

    <gazebo reference="LC_wheel">
        <mu1 value="0.001"/>
        <mu2 value="0.001"/>
    </gazebo>


</robot>
